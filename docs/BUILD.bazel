load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//docs:site.bzl", "hs_docs_site")
load("//haskell:defs.bzl", "hs_binary")

package(default_visibility = ["//visibility:private"])

exports_files(
    [
        "README.md",
        "hackage.lock.json",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "site_bzl",
    srcs = ["site.bzl"],
)

hs_binary(
    name = "docs_gen",
    srcs = ["site.hs"],
    ghc_opts = [
        "-Wall",
        "-Wcompat",
    ],
    main_module = "Main",
    deps = [
        "@hackage//:base",
        "@hackage//:filepath",
        "@hackage//:hakyll",
    ],
)

hs_docs_site(
    name = "site",
    compiler = ":docs_gen",
    haddocks = {
        "//tools/lock:lock_haddock": "haddock/lock",
    },
    srcs = glob([
        "content/**/*.md",
        "css/*",
        "templates/*",
    ]),
    visibility = ["//visibility:public"],
)

hs_binary(
    name = "serve",
    srcs = ["serve.hs"],
    data = [":site"],
    ghc_opts = [
        "-Wall",
        "-Wcompat",
    ],
    main_module = "Main",
    deps = [
        "@hackage//:base",
        "@hackage//:directory",
        "@hackage//:filepath",
        "@hackage//:wai-app-static",
        "@hackage//:warp",
    ],
)

sh_test(
    name = "site_test",
    size = "small",
    srcs = ["site_test.sh"],
    args = [
        "$(rootpath :site)",
        "$(rootpath :docs_gen)",
        "$(rootpath :serve)",
    ],
    data = [
        ":docs_gen",
        ":serve",
        ":site",
    ],
)
