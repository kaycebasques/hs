load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = [
    "//haskell:__subpackages__",
    "//tests:__subpackages__",
    "//tools:__subpackages__",
])

filegroup(
    name = "all_bzl_srcs",
    srcs = glob(["*.bzl"]),
)

cc_binary(
    name = "ghc_cc_wrapper",
    srcs = ["cc_wrapper.c"],
    copts = [
        "-std=c11",
        "-O2",
        "-Wall",
        "-Wextra",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "rt_shims",
    srcs = ["rt_shims.c"],
    copts = [
        "-std=c11",
        "-fPIC",
        "-O2",
    ],
    visibility = ["//visibility:public"],
)

cc_binary(
    name = "libtinfo.so.6",
    srcs = ["tinfo_stub.c"],
    additional_linker_inputs = ["tinfo_stub.lds"],
    copts = [
        "-std=c11",
        "-fPIC",
        "-O2",
        "-Wall",
        "-Wextra",
    ],
    linkopts = [
        "-Wl,-soname,libtinfo.so.6",
        "-Wl,--version-script=$(execpath :tinfo_stub.lds)",
    ],
    linkshared = True,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "tinfo_stub_static",
    srcs = ["tinfo_stub.c"],
    copts = [
        "-std=c11",
        "-fPIC",
        "-O2",
        "-Wall",
        "-Wextra",
    ],
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "ghc_versions_bzl",
    srcs = ["ghc_versions.bzl"],
)

bzl_library(
    name = "ghc_bindist_bzl",
    srcs = ["ghc_bindist.bzl"],
    deps = [":ghc_versions_bzl"],
)

bzl_library(
    name = "cabal_codegen_bzl",
    srcs = ["cabal_codegen.bzl"],
)

bzl_library(
    name = "hackage_bzl",
    srcs = ["hackage.bzl"],
)

bzl_library(
    name = "staged_ghc_bzl",
    srcs = ["staged_ghc.bzl"],
    deps = [
        "//haskell:providers",
        "@rules_cc//cc:action_names",
        "@rules_cc//cc:find_cc_toolchain",
        "@rules_cc//cc/common:cc_common",
        "@rules_cc//cc/common:cc_info",
    ],
)

bzl_library(
    name = "actions_bzl",
    srcs = ["actions.bzl"],
    deps = [
        "//haskell:providers",
        "//haskell:toolchain",
        "@rules_cc//cc:action_names",
        "@rules_cc//cc:find_cc_toolchain",
        "@rules_cc//cc/common:cc_common",
        "@rules_cc//cc/common:cc_info",
    ],
)

bzl_library(
    name = "cabal_library_bzl",
    srcs = ["cabal_library.bzl"],
    deps = [
        ":actions_bzl",
        "//haskell:providers",
        "//haskell:toolchain",
        "@rules_cc//cc:find_cc_toolchain",
        "@rules_cc//cc/common:cc_info",
    ],
)

bzl_library(
    name = "haddock_bzl",
    srcs = ["haddock.bzl"],
    deps = [
        ":actions_bzl",
        "//haskell:providers",
        "//haskell:toolchain",
        "@rules_cc//cc:find_cc_toolchain",
    ],
)

bzl_library(
    name = "repl_bzl",
    srcs = ["repl.bzl"],
    deps = [
        ":actions_bzl",
        "//haskell:providers",
        "//haskell:toolchain",
        "@rules_cc//cc:find_cc_toolchain",
        "@rules_cc//cc/common:cc_info",
    ],
)

bzl_library(
    name = "rules_bzl",
    srcs = ["rules.bzl"],
    deps = [
        ":actions_bzl",
        "//haskell:providers",
        "//haskell:toolchain",
        "@rules_cc//cc:find_cc_toolchain",
        "@rules_cc//cc/common:cc_info",
    ],
)
