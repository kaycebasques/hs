load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

package(default_visibility = ["//visibility:public"])

toolchain_type(
    name = "toolchain_type",
)

filegroup(
    name = "all_bzl_srcs",
    srcs = glob(["*.bzl"]) + ["//haskell/private:all_bzl_srcs"],
)

bzl_library(
    name = "providers",
    srcs = ["providers.bzl"],
)

bzl_library(
    name = "toolchain",
    srcs = ["toolchain.bzl"],
    deps = [":providers"],
)

bzl_library(
    name = "defs",
    srcs = ["defs.bzl"],
    deps = [
        "//haskell/private:rules_bzl",
    ],
)

bzl_library(
    name = "extensions",
    srcs = ["extensions.bzl"],
    deps = [
        "//haskell/private:ghc_bindist_bzl",
        "//haskell/private:ghc_versions_bzl",
        "//haskell/private:hackage_bzl",
    ],
)
