load(
    "//haskell:defs.bzl",
    "hs_alex_gen",
    "hs_cabal_library",
    "hs_happy_gen",
    "hs_library",
    "hs_test",
)

hs_alex_gen(
    name = "calc_lexer_hs",
    src = "CalcLexer.x",
    out = "CalcLexer.hs",
)

hs_happy_gen(
    name = "calc_parser_hs",
    src = "CalcParser.y",
    out = "CalcParser.hs",
)

hs_happy_gen(
    name = "lit_calc_parser_hs",
    src = "LitCalcParser.ly",
    out = "LitCalcParser.hs",
)

hs_library(
    name = "calc_grammar_lib",
    srcs = [
        ":calc_lexer_hs",
        ":calc_parser_hs",
        ":lit_calc_parser_hs",
    ],
    deps = [
        "@hs_boot//:array",
        "@hs_boot//:base",
    ],
)

hs_cabal_library(
    name = "demo_data_sublib",
    package_name = "demo-data-pkg",
    srcs = ["sub/SubHelper.hs"],
    component_name = "demo-sub",
    default_language = "Haskell2010",
    exposed_modules = ["SubHelper"],
    hs_source_dirs = ["sub"],
    version = "0.3.1",
    deps = ["@hs_boot//:base"],
)

hs_cabal_library(
    name = "demo_data_pkg",
    package_name = "demo-data-pkg",
    srcs = ["DataPkg.hs"],
    data = ["pkg_data.txt"],
    default_language = "Haskell2010",
    exposed_modules = ["DataPkg"],
    generate_paths_module = True,
    reexported_modules = ["SubHelper as DemoReexportedSub"],
    version = "0.3.1",
    deps = [
        ":demo_data_sublib",
        "@hackage//:file-embed",
        "@hs_boot//:base",
    ],
)

hs_test(
    name = "codegen_test",
    size = "small",
    srcs = ["CodegenTest.hs"],
    deps = [
        ":calc_grammar_lib",
        ":demo_data_pkg",
        "@hackage//:ansi-terminal",
        "@hackage//:attoparsec__attoparsec-internal",
        "@hackage//:base",
        "@hackage//:bytestring",
        "@hackage//:conduit",
        "@hackage//:haskell-lexer",
        "@hackage//:libyaml",
        "@hackage//:pretty-show",
        "@hackage//:unix-time",
        "@hackage//:xml-conduit",
    ],
)
