load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//haskell:defs.bzl", "hs_binary")

package(default_visibility = ["//visibility:private"])

hs_binary(
    name = "hermetic_bin",
    srcs = ["HermeticMain.hs"],
    deps = [
        "@hs_boot//:base",
        "@hs_boot//:text",
    ],
)

sh_test(
    name = "bzlmod_hygiene_test",
    size = "small",
    srcs = ["bzlmod_hygiene_test.sh"],
    args = [
        "$(rootpath //:MODULE.bazel)",
        "$(rootpath :hermetic_bin)",
    ],
    data = [
        ":hermetic_bin",
        "//:MODULE.bazel",
    ],
)

sh_test(
    name = "lock_cli_test",
    size = "small",
    srcs = ["//tools/lock:lock_cli_test.sh"],
    args = ["$(rootpath //tools/lock:lock)"],
    data = ["//tools/lock:lock"],
)
