load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//hs:defs.bzl", "hs_haddock", "hs_library")

hs_library(
    name = "core_lib",
    srcs = [
        "HaddockCore.hs",
        "HaddockSecret.hs",
    ],
    cpp_options = ["-DHADDOCK_CPP_OFFSET=42"],
    ghc_opts = [
        "-Wall",
        "-Wcompat",
    ],
    hidden_modules = ["HaddockSecret"],
    deps = ["@hs_boot//:base"],
)

hs_library(
    name = "client_lib",
    srcs = ["HaddockClient.hs"],
    ghc_opts = [
        "-Wall",
        "-Wcompat",
    ],
    deps = [
        ":core_lib",
        "@hs_boot//:base",
    ],
)

hs_haddock(
    name = "core_haddock",
    prologue = "prologue.txt",
    title = "Core Haddock Suite",
    deps = [":core_lib"],
)

hs_haddock(
    name = "client_haddock",
    haddock_deps = [":core_haddock"],
    title = "Client Haddock Suite",
    deps = [":client_lib"],
)

hs_haddock(
    name = "bundle_haddock",
    title = "Combined Core + Client Suite",
    deps = [
        ":core_lib",
        ":client_lib",
    ],
)

sh_test(
    name = "haddock_test",
    size = "small",
    srcs = ["haddock_test.sh"],
    args = [
        "$(rootpath :core_haddock)",
        "$(rootpath :client_haddock)",
        "$(rootpath :bundle_haddock)",
    ],
    data = [
        ":bundle_haddock",
        ":client_haddock",
        ":core_haddock",
    ],
)
