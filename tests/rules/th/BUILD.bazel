load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//haskell:defs.bzl", "hs_library", "hs_test")

package(default_visibility = ["//tests:__subpackages__"])

# Template Haskell support coverage:
# 1. TemplateHaskellQuotes via @hs_boot//:template-haskell (:th_quotes_lib).
# 2. Boot-package TH splices and same-library cross-module TH splices (:th_splice_lib).
# 3. Cross-library and multi-hop TH splices across separate hs_library targets,
#    including compile-time CApiFFI + runIO execution via -dynamic-too shared
#    libraries in <name>.pkgdb/dyn, while preserving base-glibc-only static
#    linking of final executables (:cross_lib_th_test + :cross_lib_th_elf_test).
# 4. Compile-time data file embedding via @hackage//:file-embed and runIO across
#    both hs_library and hs_test targets (:file_embed_th_test).

hs_library(
    name = "th_quotes_lib",
    srcs = ["ThQuotesLib.hs"],
    deps = [
        "@hs_boot//:base",
        "@hs_boot//:template-haskell",
    ],
)

hs_library(
    name = "th_splice_lib",
    srcs = [
        "ThBootSplice.hs",
        "ThCrossModSplice.hs",
        "ThHelper.hs",
    ],
    deps = [
        "@hs_boot//:base",
        "@hs_boot//:template-haskell",
    ],
)

hs_test(
    name = "th_test",
    size = "small",
    srcs = ["ThTest.hs"],
    deps = [
        ":th_quotes_lib",
        ":th_splice_lib",
        "@hs_boot//:base",
        "@hs_boot//:template-haskell",
    ],
)

hs_library(
    name = "th_cross_lib_base",
    srcs = ["ThCrossLibBase.hs"],
    hdrs = ["th_c_helper.h"],
    c_sources = ["th_c_helper.c"],
    include_dirs = ["."],
    deps = [
        "@hs_boot//:base",
        "@hs_boot//:template-haskell",
    ],
)

hs_library(
    name = "th_cross_lib_mid",
    srcs = ["ThCrossLibMid.hs"],
    deps = [
        ":th_cross_lib_base",
        "@hs_boot//:base",
        "@hs_boot//:template-haskell",
    ],
)

hs_test(
    name = "cross_lib_th_test",
    size = "small",
    srcs = ["CrossLibThTest.hs"],
    deps = [
        ":th_cross_lib_mid",
        "@hs_boot//:base",
        "@hs_boot//:template-haskell",
    ],
)

sh_test(
    name = "cross_lib_th_elf_test",
    size = "small",
    srcs = ["cross_lib_th_elf_test.sh"],
    args = ["$(rootpath :cross_lib_th_test)"],
    data = [":cross_lib_th_test"],
)

hs_library(
    name = "file_embed_lib",
    srcs = ["FileEmbedLib.hs"],
    data = ["lib_embed_fixture.txt"],
    deps = [
        "@hackage//:base",
        "@hackage//:file-embed",
        "@hackage//:template-haskell",
    ],
)

hs_test(
    name = "file_embed_th_test",
    size = "small",
    srcs = ["FileEmbedTest.hs"],
    data = ["exe_embed_fixture.txt"],
    deps = [
        ":file_embed_lib",
        "@hackage//:base",
        "@hackage//:file-embed",
        "@hackage//:template-haskell",
    ],
)
