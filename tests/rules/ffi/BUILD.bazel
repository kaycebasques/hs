load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//hs:defs.bzl", "hs_cabal_library", "hs_library", "hs_test")

cc_library(
    name = "vec_cc",
    srcs = ["vec.c"],
    hdrs = ["vec.h"],
    includes = ["."],
)

hs_library(
    name = "cc_deps_lib",
    srcs = ["CcDepsFfi.hs"],
    cc_deps = [":vec_cc"],
    deps = ["@hs_boot//:base"],
)

hs_library(
    name = "inline_c_lib",
    srcs = ["InlineCFfi.hs"],
    hdrs = ["csrc/inline_helper.h"],
    c_sources = ["csrc/inline_helper.c"],
    cc_options = ["-DINLINE_SCALE=3"],
    include_dirs = ["csrc"],
    deps = ["@hs_boot//:base"],
)

hs_library(
    name = "cxx_ffi_lib",
    srcs = ["CxxFfi.hs"],
    c_sources = ["csrc/cxx_helper.cc"],
    cc_options = [
        "-std=c++17",
        "-DCXX_BONUS=9",
    ],
    deps = ["@hs_boot//:base"],
)

hs_library(
    name = "asm_ffi_lib",
    srcs = ["AsmFfi.hs"],
    c_sources = ["csrc/asm_ops.S"] + select({
        "@platforms//cpu:arm64": ["csrc/asm_raw_arm64.s"],
        "//conditions:default": ["csrc/asm_raw_x86_64.s"],
    }),
    cc_options = ["-DASM_OFFSET=22"],
    deps = ["@hs_boot//:base"],
)

hs_library(
    name = "bcr_zlib_lib",
    srcs = ["BcrZlibFfi.hs"],
    cc_deps = ["@zlib//:zlib"],
    deps = [
        "@hs_boot//:base",
        "@hs_boot//:bytestring",
    ],
)

hs_cabal_library(
    name = "cabal_extlib_math",
    package_name = "cabal-extlib-math",
    srcs = ["ExtLibMath.hs"],
    default_language = "Haskell2010",
    exposed_modules = ["ExtLibMath"],
    extra_libraries = ["m"],
    version = "0.1.0",
    deps = ["@hs_boot//:base"],
)

hs_test(
    name = "ffi_test",
    size = "small",
    srcs = ["FfiTest.hs"],
    deps = [
        ":asm_ffi_lib",
        ":bcr_zlib_lib",
        ":cabal_extlib_math",
        ":cc_deps_lib",
        ":cxx_ffi_lib",
        ":inline_c_lib",
        "@hs_boot//:base",
        "@hs_boot//:bytestring",
    ],
)
