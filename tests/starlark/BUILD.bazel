load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(
    "//haskell:defs.bzl",
    "hs_binary",
    "hs_cabal_library",
    "hs_haddock",
    "hs_library",
    "hs_repl",
    "hs_toolchain_library",
)
load(
    ":rules_analysis_test.bzl",
    "hs_binary_action_test",
    "hs_binary_cc_propagation_test",
    "hs_cabal_c_only_test",
    "hs_cabal_library_test",
    "hs_haddock_action_test",
    "hs_library_cc_propagation_test",
    "hs_library_language_flag_test",
    "hs_library_providers_test",
    "hs_repl_cbits_and_compiled_test",
    "hs_repl_interpreted_test",
    "hs_toolchain_interpreter_tools_test",
    "strict_direct_dep_visibility_test",
    "toolchain_library_test",
    "toolchain_probe",
    "toolchain_registration_test",
)

package(default_visibility = ["//visibility:private"])

bzl_library(
    name = "rules_analysis_test_bzl",
    srcs = ["rules_analysis_test.bzl"],
    deps = [
        "//haskell:providers",
        "//haskell:toolchain",
        "@bazel_skylib//lib:unittest",
        "@rules_cc//cc/common:cc_info",
    ],
)

# ------------------------------------------------------------------------------
# Analysis fixture targets
# ------------------------------------------------------------------------------

hs_toolchain_library(
    name = "boot_text_alias",
    package_name = "text",
)

hs_library(
    name = "lib_a",
    srcs = ["LibA.hs"],
    deps = ["@hs_boot//:base"],
)

hs_library(
    name = "lib_b",
    srcs = ["LibB.hs"],
    deps = [
        ":lib_a",
        "@hs_boot//:base",
    ],
)

hs_library(
    name = "lib_c",
    srcs = ["LibC.hs"],
    ghc_opts = [
        "-Wall",
        "-Werror",
        "-O2",
    ],
    deps = [
        ":lib_b",
        "@hs_boot//:base",
    ],
)

hs_binary(
    name = "bin_threaded",
    srcs = ["SampleMain.hs"],
    cc_options = ["-DBIN_C_OPT=1"],
    threaded = True,
    deps = [
        ":lib_c",
        "@hs_boot//:base",
    ],
)

hs_binary(
    name = "bin_unthreaded",
    srcs = ["SampleMain.hs"],
    threaded = False,
    deps = [
        ":lib_c",
        "@hs_boot//:base",
    ],
)

hs_cabal_library(
    name = "cabal_h2010",
    package_name = "sample-cabal",
    srcs = ["SampleCabal.hs"],
    cc_options = ["-DCABAL_C_OPT=1"],
    default_language = "Haskell2010",
    exposed_modules = ["SampleCabal"],
    extra_libraries = ["m"],
    generate_paths_module = True,
    version = "1.2.3",
    deps = [
        ":lib_a",
        "@hs_boot//:base",
    ],
)

hs_cabal_library(
    name = "cabal_h98",
    package_name = "sample-cabal-h98",
    srcs = ["SampleCabal.hs"],
    default_language = "Haskell98",
    exposed_modules = ["SampleCabal"],
    version = "0.5.0",
    deps = [
        ":lib_a",
        "@hs_boot//:base",
    ],
)

hs_cabal_library(
    name = "cabal_c_only",
    package_name = "sample-c-only",
    hdrs = ["sample_cc.h"],
    c_sources = ["sample_cc.c"],
    include_dirs = ["."],
    install_includes = ["sample_cc.h"],
    version = "0.9.1",
)

cc_library(
    name = "sample_cc",
    srcs = ["sample_cc.c"],
    hdrs = ["sample_cc.h"],
)

hs_library(
    name = "hs_with_cc",
    srcs = ["WithCc.hs"],
    cc_deps = [":sample_cc"],
    deps = ["@hs_boot//:base"],
)

hs_library(
    name = "hs_transitive_cc",
    srcs = ["TransitiveCc.hs"],
    deps = [
        ":hs_with_cc",
        "@hs_boot//:base",
    ],
)

hs_binary(
    name = "bin_with_transitive_cc",
    srcs = ["CcMain.hs"],
    deps = [
        ":hs_transitive_cc",
        "@hs_boot//:base",
    ],
)

hs_binary(
    name = "bin_with_direct_cc",
    srcs = ["CcMain.hs"],
    cc_deps = [":sample_cc"],
    deps = ["@hs_boot//:base"],
)

hs_library(
    name = "lib_ghc2024",
    srcs = ["LibA.hs"],
    default_language = "GHC2024",
    deps = ["@hs_boot//:base"],
)

hs_haddock(
    name = "lib_a_haddock",
    hoogle = True,
    title = "LibA Docs",
    deps = [":lib_a"],
)

hs_haddock(
    name = "lib_b_haddock",
    haddock_deps = [":lib_a_haddock"],
    title = "LibB Docs",
    deps = [":lib_b"],
)

hs_repl(
    name = "lib_c_repl",
    deps = [":lib_c"],
)

hs_repl(
    name = "cc_and_compiled_repl",
    compiled_deps = [":lib_b"],
    ghci_commands = [":set +t"],
    deps = [":hs_with_cc"],
)

# ------------------------------------------------------------------------------
# Starlark analysistest targets
# ------------------------------------------------------------------------------

toolchain_library_test(
    name = "toolchain_library_base_test",
    size = "small",
    expected_module = "Prelude",
    expected_name = "base",
    target_under_test = "@hs_boot//:base",
)

toolchain_library_test(
    name = "toolchain_library_explicit_name_test",
    size = "small",
    expected_module = "Data.Text",
    expected_name = "text",
    target_under_test = ":boot_text_alias",
)

hs_library_providers_test(
    name = "hs_library_providers_test",
    size = "small",
    lib_a = ":lib_a",
    lib_b = ":lib_b",
    target_under_test = ":lib_c",
)

strict_direct_dep_visibility_test(
    name = "strict_direct_dep_visibility_test",
    size = "small",
    base_dep = "@hs_boot//:base",
    direct_dep = ":lib_b",
    target_under_test = ":lib_c",
    transitive_dep = ":lib_a",
)

hs_binary_action_test(
    name = "hs_binary_threaded_true_test",
    size = "small",
    direct_dep = ":lib_c",
    expect_threaded = True,
    target_under_test = ":bin_threaded",
    transitive_dep = ":lib_a",
)

hs_binary_action_test(
    name = "hs_binary_threaded_false_test",
    size = "small",
    direct_dep = ":lib_c",
    expect_threaded = False,
    target_under_test = ":bin_unthreaded",
    transitive_dep = ":lib_b",
)

hs_cabal_library_test(
    name = "hs_cabal_library_h2010_test",
    size = "small",
    expect_paths_module = True,
    expected_language = "Haskell2010",
    expected_pkg_name = "sample-cabal",
    expected_version = "1.2.3",
    forbidden_language = "Haskell98",
    target_under_test = ":cabal_h2010",
)

hs_cabal_library_test(
    name = "hs_cabal_library_h98_test",
    size = "small",
    expect_paths_module = False,
    expected_language = "Haskell98",
    expected_pkg_name = "sample-cabal-h98",
    expected_version = "0.5.0",
    forbidden_language = "Haskell2010",
    target_under_test = ":cabal_h98",
)

hs_cabal_c_only_test(
    name = "hs_cabal_c_only_test",
    size = "small",
    target_under_test = ":cabal_c_only",
)

hs_library_cc_propagation_test(
    name = "hs_library_direct_cc_propagation_test",
    size = "small",
    cc_dep = ":sample_cc",
    target_under_test = ":hs_with_cc",
)

hs_library_cc_propagation_test(
    name = "hs_library_transitive_cc_propagation_test",
    size = "small",
    cc_dep = ":sample_cc",
    target_under_test = ":hs_transitive_cc",
)

hs_binary_cc_propagation_test(
    name = "hs_binary_transitive_cc_propagation_test",
    size = "small",
    cc_dep = ":sample_cc",
    target_under_test = ":bin_with_transitive_cc",
)

hs_binary_cc_propagation_test(
    name = "hs_binary_direct_cc_propagation_test",
    size = "small",
    cc_dep = ":sample_cc",
    target_under_test = ":bin_with_direct_cc",
)

hs_haddock_action_test(
    name = "hs_haddock_action_test",
    size = "small",
    expect_hoogle = False,
    target_under_test = ":lib_b_haddock",
    upstream_haddock = ":lib_a_haddock",
)

hs_haddock_action_test(
    name = "hs_haddock_hoogle_action_test",
    size = "small",
    expect_hoogle = True,
    target_under_test = ":lib_a_haddock",
)

hs_library_language_flag_test(
    name = "hs_library_ghc2024_flag_test",
    size = "small",
    expected_language = "GHC2024",
    target_under_test = ":lib_ghc2024",
)

toolchain_registration_test(
    name = "toolchain_linux_x86_64_registered_test",
    size = "small",
    target_under_test = "@hs_toolchains//:ghc_linux_x86_64",
)

toolchain_registration_test(
    name = "toolchain_linux_arm64_registered_test",
    size = "small",
    target_under_test = "@hs_toolchains//:ghc_linux_arm64",
)

hs_repl_interpreted_test(
    name = "hs_repl_interpreted_test",
    size = "small",
    base_dep = "@hs_boot//:base",
    direct_compiled_dep = ":lib_b",
    interpreted_dep = ":lib_c",
    target_under_test = ":lib_c_repl",
    transitive_dep = ":lib_a",
)

hs_repl_cbits_and_compiled_test(
    name = "hs_repl_cbits_and_compiled_test",
    size = "small",
    compiled_dep = ":lib_b",
    target_under_test = ":cc_and_compiled_repl",
)

toolchain_probe(
    name = "active_toolchain_probe",
)

hs_toolchain_interpreter_tools_test(
    name = "hs_toolchain_interpreter_tools_test",
    size = "small",
    target_under_test = ":active_toolchain_probe",
)
