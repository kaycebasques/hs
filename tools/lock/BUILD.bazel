load("//haskell:defs.bzl", "hs_binary", "hs_haddock", "hs_library", "hs_test")

package(default_visibility = ["//visibility:private"])

exports_files(
    ["lock_cli_test.sh"],
    visibility = ["//tests/rules:__pkg__"],
)

hs_library(
    name = "lock_lib",
    srcs = [
        "CabalExtract.hs",
        "LockJson.hs",
    ],
    deps = [
        "@hs_boot//:Cabal-syntax",
        "@hs_boot//:base",
        "@hs_boot//:bytestring",
        "@hs_boot//:containers",
        "@hs_boot//:text",
    ],
)

hs_haddock(
    name = "lock_haddock",
    prologue = "prologue.txt",
    title = "rules_haskell //tools/lock API Reference",
    visibility = ["//visibility:public"],
    deps = [":lock_lib"],
)

hs_binary(
    name = "lock",
    srcs = ["Main.hs"],
    main_module = "Main",
    visibility = ["//visibility:public"],
    deps = [
        ":lock_lib",
        "@hs_boot//:Cabal-syntax",
        "@hs_boot//:base",
        "@hs_boot//:bytestring",
        "@hs_boot//:containers",
        "@hs_boot//:directory",
        "@hs_boot//:filepath",
        "@hs_boot//:process",
        "@hs_boot//:text",
    ],
)

hs_test(
    name = "lock_test",
    size = "small",
    srcs = ["LockTest.hs"],
    main_module = "Main",
    deps = [
        ":lock_lib",
        "@hs_boot//:Cabal-syntax",
        "@hs_boot//:base",
        "@hs_boot//:bytestring",
        "@hs_boot//:containers",
        "@hs_boot//:text",
    ],
)
